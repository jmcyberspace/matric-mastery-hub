# Copy or generate this on the VPS. Never commit the real .env file.
NODE_ENV=production
APP_ORIGIN=https://learn.example.org
PRIVACY_CONTACT=privacy@example.org
PORT=3010
DATABASE_NAME=matric_mastery
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_DB_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# DATABASE_URL is constructed by Docker Compose; for local development use:
# DATABASE_URL=postgresql://matric_app:PASSWORD@127.0.0.1:5432/matric_mastery
# Live AI is optional. Both values must be configured to enable it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=1000
# Authenticated TLS SMTP enables password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
