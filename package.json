{
  "name": "matric-mastery-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ui": "node --import tsx --test --test-concurrency=1 tests/*.test.jsx",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.60.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vite": "8.3.4"
  }
}
